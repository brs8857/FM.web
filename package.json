{
  "name": "fm-web",
  "private": true,
  "version": "2.7.0",
  "type": "module",
  "description": "Era XI — draft an XI from 33 years of the English top flight, one club-season at a time, build a tactic on the chalkboard, and play a six-season career with promotion and relegation.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "vite build --mode standalone",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "golden:capture": "node scripts/capture-golden.mjs",
    "golden:engine": "node scripts/capture-golden.mjs --engine",
    "data:check": "node scripts/derive-ratings.mjs --check",
    "sim": "node scripts/sim.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
